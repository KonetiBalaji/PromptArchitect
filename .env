# Prompt Architect Environment Variables
# Author: Balaji Koneti
# Copy this file to .env and fill in your API keys

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: for custom endpoints

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com  # Optional: for custom endpoints

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com  # Optional: for custom endpoints

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=  # Optional: Redis password
REDIS_DB=0  # Optional: Redis database number

# Application Configuration
APP_ENV=development  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO

# Security Configuration
SECRET_KEY=your_secret_key_here  # For session management and encryption
ALLOWED_HOSTS=localhost,127.0.0.1  # Comma-separated list of allowed hosts

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_LIMIT=10

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_PROMPT_TTL=7200
CACHE_RESPONSE_TTL=1800

# Performance Configuration
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_INTERVAL=60
PROMETHEUS_PORT=8000  # Optional: Prometheus metrics port

# Database Configuration (if using persistent storage)
DATABASE_URL=sqlite:///prompt_architect.db  # SQLite for development
# DATABASE_URL=postgresql://user:password@localhost/prompt_architect  # PostgreSQL for production

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_USE_TLS=true

# Webhook Configuration (for external integrations)
WEBHOOK_URL=  # Optional: Webhook URL for notifications
WEBHOOK_SECRET=  # Optional: Webhook secret for verification

# Feature Flags
ENABLE_DYNAMIC_SELECTION=true
ENABLE_AB_TESTING=false
ENABLE_COST_OPTIMIZATION=true
ENABLE_PERFORMANCE_OPTIMIZATION=true

# Development Configuration
MOCK_PROVIDERS=false  # Set to true for testing without real API calls
TEST_MODE=false
VERBOSE_LOGGING=false

# Custom Model Endpoints (for self-hosted models)
CUSTOM_OPENAI_ENDPOINT=  # Optional: Custom OpenAI-compatible endpoint
CUSTOM_CLAUDE_ENDPOINT=  # Optional: Custom Claude-compatible endpoint
CUSTOM_GEMINI_ENDPOINT=  # Optional: Custom Gemini-compatible endpoint

# Analytics Configuration
ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=  # Optional: Google Analytics tracking ID
MIXPANEL_TOKEN=  # Optional: Mixpanel tracking token

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_INTERVAL=24  # hours
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=  # Optional: S3 bucket for backups
BACKUP_S3_ACCESS_KEY=  # Optional: S3 access key
BACKUP_S3_SECRET_KEY=  # Optional: S3 secret key
